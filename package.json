{
  "name": "@iqkv/standard-blank-ui-project-layout",
  "version": "0.0.0",
  "description": "Modern React 19 starter template with TypeScript, Vite, TanStack Router & Query, and Feature-Sliced Design architecture",
  "keywords": [
    "react",
    "react-19",
    "typescript",
    "vite",
    "tanstack",
    "starter-template",
    "fsd"
  ],
  "homepage": "https://github.com/IQKV/standard-blank-ui-project-layout#readme",
  "bugs": {
    "url": "https://github.com/IQKV/standard-blank-ui-project-layout/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IQKV/standard-blank-ui-project-layout.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b && pnpm messages:extract && pnpm messages:compile && vite build",
    "ci": "pnpm ci:lint && pnpm ci:test",
    "ci:lint": "pnpm lint",
    "ci:test": "pnpm test",
    "dev": "vite",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:stylelint": "stylelint \"**/*.css\" --aei",
    "messages:compile": "lingui compile",
    "messages:extract": "lingui extract",
    "node_modules:clear": "rm -rf node_modules",
    "prepare": "husky",
    "prettier:check": "prettier . --check --ignore-unknown",
    "prettier:write": "prettier . --write",
    "preview": "vite preview",
    "release": "release-it --ci",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest run",
    "test:arch": "vitest run architecture",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest run --ui",
    "test:wath": "vitest",
    "type-check": "tsc --noEmit"
  },
  "lint-staged": {
    "*": [
      "pnpm prettier:check"
    ],
    "package.json": [
      "sort-package-json"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
