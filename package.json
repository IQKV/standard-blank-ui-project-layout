{
  "name": "@iqkv/standard-blank-ui-project-layout",
  "version": "0.0.0",
  "description": "Modern React 19 starter template with TypeScript, Vite, TanStack Router & Query, and Feature-Sliced Design architecture",
  "keywords": [
    "fsd",
    "react",
    "react-19",
    "starter-template",
    "tanstack",
    "typescript",
    "vite"
  ],
  "homepage": "https://github.com/dimdnk/standard-blank-ui-project-layout#readme",
  "bugs": {
    "url": "https://github.com/dimdnk/standard-blank-ui-project-layout/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimdnk/standard-blank-ui-project-layout.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -b && pnpm messages:extract && pnpm messages:compile && vite build",
    "ci": "pnpm ci:lint && pnpm ci:test",
    "ci:lint": "pnpm lint",
    "ci:test": "pnpm test",
    "dev": "vite",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "formatter:check": "oxfmt --check",
    "formatter:write": "oxfmt --write",
    "knip": "knip",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix && pnpm formatter:write",
    "lint:stylelint": "stylelint \"**/*.css\" --aei",
    "messages:compile": "lingui compile",
    "messages:extract": "lingui extract",
    "node_modules:cleanup": "rm -rf node_modules",
    "prepare": "husky",
    "preview": "vite preview",
    "release": "release-it --ci",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest run",
    "test:arch": "vitest run architecture",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest run --ui",
    "test:wath": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@dr.pogodin/react-helmet": "^3.1.1",
    "@hookform/resolvers": "^5.2.2",
    "@lingui/core": "^6.0.0",
    "@lingui/format-po": "^6.0.0",
    "@lingui/react": "^6.0.0",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@stripe/react-stripe-js": "^4.0.2",
    "@stripe/stripe-js": "^7.9.0",
    "@tabler/icons-react": "^3.41.1",
    "@tanstack/react-query": "^5.100.5",
    "@tanstack/react-router": "^1.168.25",
    "@types/sanitize-html": "^2.16.1",
    "axios": "^1.15.2",
    "chroma-js": "^3.2.0",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "collect.js": "^4.36.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "graphql-request": "^7.4.0",
    "immer": "^11.1.4",
    "js-cookie": "^3.0.5",
    "lodash": "^4.18.1",
    "lottie-web": "^5.13.0",
    "miragejs": "^0.1.48",
    "nuqs": "^2.8.9",
    "query-string": "^9.3.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.74.0",
    "react-icons": "^5.6.0",
    "react-infinite-scroll-component": "^7.2.0",
    "react-lottie": "^1.2.10",
    "sanitize-html": "^2.17.3",
    "ts-pattern": "^5.9.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@lingui/cli": "^6.0.0",
    "@lingui/swc-plugin": "^6.0.0",
    "@lingui/vite-plugin": "^6.0.0",
    "@playwright/test": "1.59.1",
    "@release-it/conventional-changelog": "^10.0.6",
