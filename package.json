{
  "name": "@iqkv/standard-ui-project-layout",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "ci": "pnpm run ci:lint && pnpm run ci:test",
    "ci:lint": "pnpm lint",
    "ci:test": "pnpm test",
    "dev": "vite",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:stylelint": "stylelint \"**/*.css\" --cache",
    "prepare": "husky",
    "prettier:check": "prettier . --check",
    "prettier:write": "prettier . --write",
    "preview": "vite preview",
    "release": "release-it --ci",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest",
    "type-check": "tsc --noEmit",
    "node_modules:clear": "rm -rf node_modules"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@hookform/resolvers": "^5.1.1",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@reduxjs/toolkit": "^2.8.2",
    "@tabler/icons-react": "^3.34.0",
    "@tanstack/react-query": "^5.80.10",
    "@tanstack/react-router": "^1.123.2",
    "@types/sanitize-html": "^2.16.0",
    "axios": "^1.10.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.13",
    "dotenv": "^17.0.1",
    "graphql-request": "^7.2.0",
    "i18next": "^25.3.0",
    "lodash": "^4.17.21",
    "lottie-web": "^5.12.2",
    "miragejs": "^0.1.48",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.60.0",
    "react-i18next": "^15.6.0",
    "react-icons": "^5.5.0",
    "react-infinite-scroll-component": "^6.1.0",
    "react-lottie": "^1.2.10",
    "sanitize-html": "^2.17.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint-react/eslint-plugin": "^1.51.2",
    "@eslint/js": "^9.30.1",
    "@playwright/test": "1.53.2",
    "@semantic-release/git": "^10.0.1",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/addon-themes": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/preview-api": "^8.6.13",
    "@storybook/react": "^8.6.10",
    "@storybook/react-vite": "^8.6.10",
    "@storybook/test": "^8.6.9",
    "@tanstack/eslint-plugin-query": "^5.74.7",
    "@tanstack/eslint-plugin-router": "^1.125.0",
    "@tanstack/react-query-devtools": "^5.81.5",
    "@tanstack/router-devtools": "^1.120.6",
    "@tanstack/router-plugin": "^1.120.15",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-formatter-checkstyle": "^8.40.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-x": "^4.15.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.3",
    "gitzy": "5.9.0",
    "globals": "^16.3.0",
    "happy-dom": "18.0.1",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "is-ci": "4.1.0",
    "jiti": "2.4.2",
    "jsdom": "^26.1.0",
    "knip": "5.61.3",
    "lefthook": "1.11.16",
    "lint-staged": "^16.1.2",
    "lru-cache": "^11.1.0",
    "msw": "^2.10.3",
    "nx": "^21.2.2",
    "postcss": "^8.5.6",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "3.6.2",
    "prettier-plugin-packagejson": "2.5.18",
    "prop-types": "^15.8.1",
    "release-it": "^19.0.2",
    "semantic-release": "^24.2.6",
    "sort-package-json": "^3.4.0",
    "storybook": "^8.6.14",
    "storybook-dark-mode": "^4.0.2",
    "stylelint": "^16.21.1",
    "stylelint-config-standard-scss": "^15.0.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.35.1",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "v3.2.4"
  },
  "release-it": {
    "npm": {
      "publish": false
    },
    "git": {
      "commit": true,
      "tag": true,
      "push": true,
      "commitMessage": "feat: bump v${version}",
      "changelog": "npx auto-changelog --stdout --commit-limit false -u --template https://raw.githubusercontent.com/release-it/release-it/main/templates/changelog-compact.hbs"
    },
    "hooks": {
      "after:bump": "npx auto-changelog -p"
    }
  }
}
